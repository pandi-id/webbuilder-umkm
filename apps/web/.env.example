# =============================================================================
# apps/web — Next.js Dashboard (admin + editor)
# =============================================================================
# Dipakai saat development langsung di host:
#   cd apps/web && cp .env.example .env.local && npm run dev
#
# Next.js otomatis load .env.local (jangan commit). Variabel berawalan
# NEXT_PUBLIC_ akan di-inline ke bundle client-side, jangan taruh secret di sini.
# =============================================================================

# URL ke API yang bisa diakses dari BROWSER user.
# - Docker Compose dev: http://api.localhost  (lewat Caddy)
# - Tanpa Docker dev:   http://localhost:8080 (langsung ke Go server)
# - Production:         https://api.yourdomain.com
NEXT_PUBLIC_API_BASE=http://api.localhost

# URL renderer (host publik / Caddy root). Dipakai untuk membuka link
# "Pratinjau" draft di tab baru. Kosong → fallback ke window.location.origin
# (jarang benar; biasanya editor di app.localhost dan renderer di localhost).
NEXT_PUBLIC_RENDERER_BASE=http://localhost
