# =============================================================================
# apps/api — Go Fiber API
# =============================================================================
# File ini dipakai ketika menjalankan API langsung di host:
#   cd apps/api && cp .env.example .env && go run ./cmd/server
#
# main.go otomatis load file `.env` dari working directory via godotenv.
# OS environment yang sudah di-set selalu menang, jadi Docker Compose
# passthrough tetap berfungsi tanpa perlu file .env di container.
# =============================================================================

APP_ENV=development
LOG_LEVEL=info       # debug | info | warn | error
HTTP_ADDR=:8080

# Public dashboard URL — dipakai untuk membangun link reset password & verifikasi email,
# JUGA dipakai sebagai target redirect setelah callback OAuth (misal Google login).
APP_BASE_URL=http://app.localhost

# --- Google OAuth ---
# Kosongkan ketiganya = tombol "Login dengan Google" otomatis di-503 oleh API
# dan idealnya disembunyikan di UI. Isi semuanya = flow aktif.
#
# Setup di Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application).
# Authorized redirect URI HARUS persis sama dengan GOOGLE_OAUTH_REDIRECT_URL di bawah
# (termasuk skema http/https dan port). Untuk dev: http://api.localhost/api/v1/auth/google/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://api.localhost/api/v1/auth/google/callback

# --- e.id SSO (https://docs.e.id/en/oauth-sso) ---
# Kosongkan client ID/secret = tombol "Masuk dengan e.id" disembunyikan.
# Dapatkan dari developer dashboard e.id. Callback URL TIDAK perlu env: API
# memakai <skema APP_BASE_URL>://<PUBLIC_API_HOST>/api/v1/auth/eid/callback —
# daftarkan URL itu persis di dashboard e.id (lihat log "eid oauth: enabled").
# EID_API_BASE: production https://api-wallet.e.id; sandbox https://api-dev.e.id
# (Postman resmi memakai https://gateway-sandbox.e.id — ikuti dashboard developer).
EID_OAUTH_CLIENT_ID=
EID_OAUTH_CLIENT_SECRET=
EID_API_BASE=https://api-dev.e.id

# --- api-registry backend (PRIMARY — Fase 1 self-sufficient) ---
# Web builder full pakai api-registry untuk EPP execution + business logic
# lokal (wallet/invoice/pricing/promo/document semua di web builder DB).
#
# WAJIB isi 2 env di bawah untuk fungsi domain purchase / renew:
#   - API_REGISTRY_URL       : URL service api-registry
#   - API_REGISTRY_HMAC_SECRET: shared secret dengan api-registry
#                              (must match INTERNAL_HMAC_SECRET di api-registry)
#
# Kalau KOSONG semua → feature "Beli Domain" auto-hidden di dashboard.
API_REGISTRY_URL=http://api-registry:5000
API_REGISTRY_HMAC_SECRET=change-me-in-production-min-32-char
API_REGISTRY_TIMEOUT=30s

# --- Database ---
DATABASE_URL=postgres://webbuilder:webbuilder@localhost:5432/webbuilder?sslmode=disable

# --- JWT ---
JWT_SECRET=change-me-in-production-please
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# --- Caddy on-demand TLS hook ---
# Dipakai untuk validasi sebelum issuing cert untuk custom domain user.
CADDY_ASK_SECRET=dev-caddy-secret

# --- Hosts (untuk validasi Caddy ask + CORS) ---
PUBLIC_APP_HOST=app.localhost
PUBLIC_API_HOST=api.localhost
RENDERER_DEFAULT_HOST=localhost
CORS_ORIGINS=http://localhost:3000,http://app.localhost

# --- Platform IPs (security: domain verification allowlist) ---
# WAJIB di-set di production. Saat user verify custom domain, server
# memastikan DNS A record mengarah ke salah satu IP ini. Tanpa allowlist,
# user bisa "claim" domain yang DNS-nya menunjuk ke server lain.
# Kosongkan di dev → INSECURE (any A record passes).
# PLATFORM_IPS=1.2.3.4,5.6.7.8

# --- Admin bootstrap (idempotent) ---
# Saat API start, user dengan email ini di-upsert dengan role=admin.
# Kalau user sudah ada, hanya role yang dipaksa admin; password tidak diubah.
# Kosongkan untuk skip.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme1234
ADMIN_NAME=Administrator

# --- Demo seed (opt-in) ---
# Saat true, insert 1 user demo + 1 situs UMKM + 5 produk + 3 artikel blog.
# Skip otomatis kalau user demo sudah ada.
SEED_DEMO=false
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=demo1234

# --- Storage ---
# Pilih satu driver: local | s3
# - "local" = tulis ke disk, served oleh API di /uploads/*
# - "s3"    = MinIO atau AWS S3 (protokol sama)
STORAGE_DRIVER=local

# Local driver
STORAGE_LOCAL_DIR=./uploads
STORAGE_LOCAL_PUBLIC_URL=http://api.localhost/uploads

# S3 / MinIO driver (dipakai saat STORAGE_DRIVER=s3)
STORAGE_S3_ENDPOINT=minio:9000
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=assets
STORAGE_S3_USE_SSL=false
STORAGE_S3_PUBLIC_URL=http://localhost:9000/assets

# --- Mail driver ---
# Dipakai untuk reset password + email verification.
#   "log"  = print isi email ke stdout (default — cocok untuk dev)
#   "smtp" = kirim via SMTP server (production)
MAIL_DRIVER=log

# SMTP (wajib kalau MAIL_DRIVER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Web Builder <no-reply@example.com>
SMTP_STARTTLS=true

# --- Error tracking ---
# Set DSN dari Sentry / GlitchTip / self-hosted compatible. Kosong = disabled.
SENTRY_DSN=

# --- DB pool tuning ---
# MaxConns: tinggi-kan kalau Postgres punya headroom. Idealnya = (workers/instance) * 1.5.
# SlowQueryThreshold: query lebih lama dari ini dilog sebagai warning (defaults 500ms).
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=15m
DB_SLOW_QUERY_THRESHOLD=500ms

# --- Operations ---
# Saat true, /api/v1/admin/debug/pprof/* tersedia untuk role=admin.
# Default false — pprof bisa membocorkan secrets di heap profile.
PPROF_ENABLED=false

# Kalau true, semua rate limiter (RateLimitIP + RateLimitUser) pass-through
# — tidak gate request. Dipakai saat dev / load test / debug cepat "kena 429".
# JANGAN aktifkan di production tanpa WAF/CDN di depan (brute force risk).
# Default false (rate limit aktif).
RATE_LIMIT_DISABLED=false

# --- Image compression (asset upload) ---
# Re-encode JPEG/PNG saat upload: downscale ke MAX_DIMENSION (px longest edge)
# dan kompres JPEG ke quality JPEG_QUALITY. GIF + WebP dilewati (animasi /
# sudah efisien). Set ENABLED=false untuk simpan original bytes apa adanya.
IMAGE_COMPRESS_ENABLED=true
IMAGE_MAX_DIMENSION=2000
IMAGE_JPEG_QUALITY=82

# Contoh AWS S3 production (Singapore):
# STORAGE_DRIVER=s3
# STORAGE_S3_ENDPOINT=s3.ap-southeast-1.amazonaws.com
# STORAGE_S3_ACCESS_KEY=AKIA...
# STORAGE_S3_SECRET_KEY=...
# STORAGE_S3_REGION=ap-southeast-1
# STORAGE_S3_BUCKET=my-webbuilder-assets
# STORAGE_S3_USE_SSL=true
# STORAGE_S3_PUBLIC_URL=https://my-webbuilder-assets.s3.ap-southeast-1.amazonaws.com

# invoices
# NEXT_PUBLIC_COMPANY_NAME=PANDI Web Builder
# NEXT_PUBLIC_COMPANY_ADDRESS=Jl. ... Jakarta
# NEXT_PUBLIC_COMPANY_EMAIL=billing@pandi.id
# NEXT_PUBLIC_COMPANY_TAX_ID=01.234.567.8-901.000