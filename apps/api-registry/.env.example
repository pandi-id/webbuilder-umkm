# === HTTP server ===
PORT=5000
APP_ENV=dev              # dev | staging | prod
LOG_LEVEL=info           # debug | info | warn | error

# === Provider selection ===
# epp_direct    : native EPP client via pandi-id/epp-pandi-client — RECOMMENDED.
#                 Customer registrar dengan EPP credentials sendiri, zero
#                 dependency ke registrar-api PANDI. Wajib set EPP_* env di bawah.
# pandi_wrapper : legacy HTTP proxy ke registrar-api PANDI (hybrid transition
#                 only — untuk operator yang belum ready EPP direct).
PROVIDER_MODE=epp_direct

# === EPP direct credentials (PRIMARY — wajib untuk PROVIDER_MODE=epp_direct) ===
# Native EPP client langsung ke PANDI registry.
# Prasyarat: customer adalah PANDI-accredited registrar dengan credentials.
EPP_HOST=epp1.pandi.id        # OT&E: ote.pandi.id (biasanya beda port)
EPP_PORT=700
EPP_USER=                     # dari PANDI onboarding
EPP_PASSWORD=
EPP_CERT_FILE=/etc/api-registry/epp-client.crt   # client cert PEM
EPP_KEY_FILE=/etc/api-registry/epp-client.key    # client private key PEM
EPP_CA_FILE=/etc/api-registry/pandi-ca.crt       # registry CA (opsional)
EPP_INSECURE_SKIP_VERIFY=false   # true = dev/OT&E dengan self-signed
EPP_KEEPALIVE_INTERVAL=5m        # hello frame interval untuk cegah session drop
# EPP_PER_COMMAND_SESSION — connect+login+logout tiap command (no session reuse).
# Trade-off: +200-500ms latency per command, tapi immune ke session drop di sisi
# registrar (idle timeout, server restart). Set `true` kalau sering 502 karena
# session stale. Default false = reuse session across command.
EPP_PER_COMMAND_SESSION=false

# === Internal auth (web builder → api-registry) ===
# HMAC shared secret (min 32 char di prod). Kosong = dev mode (no auth).
# Generate: openssl rand -hex 32
INTERNAL_HMAC_SECRET=

# === Runtime tuning ===
REQUEST_TIMEOUT=30s
MAX_CONCURRENT=20        # limit inflight EPP call (registry session cap)

# === Webhook relay (registrar-api → api-registry → web builder) ===
# Verify inbound webhook dari registrar-api. Kalau kosong = dev mode (skip verify).
WEBHOOK_UPSTREAM_SECRET=

# Forward ke web builder. Kalau kosong, api-registry cuma verify + audit
# (tidak forward — cocok untuk staging tanpa web builder yang match).
WEBBUILDER_WEBHOOK_URL=
WEBBUILDER_WEBHOOK_SECRET=
WEBHOOK_FORWARD_TIMEOUT=10s

# === Resilience (retry + circuit breaker) ===
# Kalau upstream (registrar-api / EPP) flaky, kita retry transient error
# (network/5xx/429) + circuit break setelah N consecutive fail supaya tidak
# cascade. Default enabled — set false untuk debug raw upstream behavior.
RESILIENCE_ENABLED=true

# Retry — exponential backoff dengan jitter ±20%.
RETRY_MAX_ATTEMPTS=3          # total attempt (1 initial + 2 retry)
RETRY_INITIAL_DELAY=200ms     # sleep pertama sebelum retry
RETRY_MAX_DELAY=5s            # cap delay antar retry

# Circuit breaker — per-operation (bukan global).
CIRCUIT_FAILURE_THRESHOLD=5   # consecutive transient failure → open
CIRCUIT_COOLDOWN_PERIOD=30s   # durasi open sebelum probe half-open

# === LEGACY: PANDI wrapper credentials (DEPRECATED) ===
# Hanya diperlukan kalau PROVIDER_MODE=pandi_wrapper (hybrid transition).
# Recommended: gunakan PROVIDER_MODE=epp_direct + kosongkan block ini.
#
# PANDI_API_URL=http://localhost:8080
# PANDI_API_KEY=               # static JWT (rotate manual sebelum 30 hari)
# PANDI_EMAIL=reseller@example.com  # atau email+password (auto-refresh 25d)
# PANDI_PASSWORD=changeme
# PANDI_API_TIMEOUT=15s

# === EPP debug ===
# EPP_LOG_FILE — path file untuk EPP log. Kosong = off (dev tanpa trace).
# Kalau di-set, DUA file ditulis:
#   <path>           : raw XML + connection events (zap, library-level).
#   <path>-ops.jsonl : 1 baris JSON per EPP operation dari parseResponse
#                      (op, bytes, code, ok, msg, xml snippet, error).
# Dipakai untuk trace error upstream — mis. "Transaction rolled back"
# yang muncul di contact:create response. Selalu aktif per operation
# tanpa butuh EPP_DEBUG_XML.
EPP_LOG_FILE=./logs/epp.log

# EPP_DEBUG_XML — kalau true, api-registry dump request frame (marshaled) +
# response raw XML ke slog per command. Pakai untuk debug "kenapa EPP tolak
# NS/contact/etc". WARNING: XML bisa include credential (login), PII (contact
# details), authInfo. HANYA untuk dev/staging. Default false.
EPP_DEBUG_XML=false
