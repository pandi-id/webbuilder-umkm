# Env yang wajib di-set di service Caddy (systemd override, lihat
# docs/deploy-caddy-ubuntu.md): CADDY_ASK_SECRET (sama dengan .env API) dan
# APP_UPSTREAM_HOST (host app/api/renderer; default 127.0.0.1).
# Global options
{
    # Email untuk ACME registration + notifikasi cert expiry.
    email teknis@pandi.id
    acme_ca https://acme-v02.api.letsencrypt.org/directory

    # On-demand TLS: Caddy tanya ke API sebelum issue cert untuk domain baru.
    # Cegah cert issuance dari attacker yang point DNS random ke server kita.
    on_demand_tls {
        ask https://api.kubaca.id/internal/caddy/ask?secret={$CADDY_ASK_SECRET}
        interval 2m
        burst 5
    }

    # HTTP/3 default on. Kalau ada issue firewall UDP, uncomment ini.
    # servers {
    #     protocols h1 h2
    # }
}


# ---------- Platform dashboards ----------

# Dashboard admin / reseller / agent / client
kubaca.id {
    reverse_proxy {$APP_UPSTREAM_HOST:127.0.0.1}:4000

    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # HSTS 1 tahun + preload — pastikan yakin HTTPS-only sebelum enable.
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }

    log {
        output file /var/log/caddy/app-access.log {
            roll_size 100mb
            roll_keep 5
        }
    }
}


# Public API — CORS di-handle di API side (Fiber middleware).
api.kubaca.id {
    reverse_proxy {$APP_UPSTREAM_HOST:127.0.0.1}:4011 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Naikkan timeout — EPP login / registry lookup kadang butuh 2-5 detik,
        # default Caddy 30s cukup tapi transient network glitch bisa timeout.
        transport http {
            dial_timeout 5s
            response_header_timeout 60s
            read_timeout 120s
        }
    }

    # Larger body untuk upload dokumen / bukti transfer / template pages_json.
    request_body {
        max_size 20MB
    }

    log {
        output file /var/log/caddy/api-access.log {
            roll_size 100mb
            roll_keep 5
        }
    }
}


# ---------- Renderer (public multi-tenant SSR) ----------

# Subdomain platform khusus renderer — dipakai:
#   - Template preview iframe di dashboard admin/wizard client
#     (set env NEXT_PUBLIC_RENDERER_BASE=https://preview.kubaca.id)
#   - Kalau butuh URL "default site" untuk demo, redirect ke sini
#
# Bedanya dengan :443 catch-all: subdomain platform TIDAK butuh on-demand TLS
# (Caddy issue cert normal, tidak call ask endpoint), lebih cepat + zero
# tergantung state API.
preview.kubaca.id {
    reverse_proxy {$APP_UPSTREAM_HOST:127.0.0.1}:4001 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up Host {host}

        transport http {
            dial_timeout 5s
            response_header_timeout 60s
            read_timeout 120s
        }
    }

    log {
        output file /var/log/caddy/renderer-preview.log {
            roll_size 100mb
            roll_keep 5
        }
    }
}

# Catch-all untuk custom domain user (myshop.id, dst.). Caddy call `ask`
# endpoint sebelum ACME issuance.
:443 {
    tls {
        on_demand
    }

    reverse_proxy {$APP_UPSTREAM_HOST:127.0.0.1}:4001 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up Host {host}

        transport http {
            dial_timeout 5s
            response_header_timeout 60s
            read_timeout 120s
        }
    }

    log {
        output file /var/log/caddy/renderer-tenant.log {
            roll_size 200mb
            roll_keep 10
        }
    }
}


# HTTP → 401 → auto-redirect ke HTTPS untuk domain yang punya cert.
# Caddy handle otomatis; tapi untuk custom domain yang belum on-boarded,
# passthrough ke renderer supaya user tetap dapet response
# (misalnya "domain belum terhubung ke situs Anda").
:80 {
    reverse_proxy {$APP_UPSTREAM_HOST:127.0.0.1}:4001
}
