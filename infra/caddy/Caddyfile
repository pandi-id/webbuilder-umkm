{
	# On-demand TLS: ask the API before issuing a cert for an unknown host.
	# Secret is passed as query to prove the request came from Caddy, not from
	# a random caller who reached the API.
	on_demand_tls {
		ask http://api:8080/internal/caddy/ask?secret={$CADDY_ASK_SECRET}
		interval 2m
		burst 5
	}
}

# Dashboard / editor.
app.localhost {
	reverse_proxy web:3000
}

# Public API — tidak perlu CSP (JSON API, bukan HTML yang di-render browser).
api.localhost {
	@cors {
		header Origin *
	}
	reverse_proxy api:8080
}

# Default localhost = renderer (so http://localhost works in dev)
localhost {
	reverse_proxy renderer:3000
}

# Catch-all for any other host (subdomain or custom domain).
# Caddy will call the ask endpoint before issuing TLS.
:443 {
	tls {
		on_demand
	}
	reverse_proxy renderer:3000
}

:80 {
	reverse_proxy renderer:3000
}
